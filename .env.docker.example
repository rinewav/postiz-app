# Docker self-host settings. `cp .env.docker.example .env` (gitignored), then fill in.
# Read by docker-compose.override.yml via compose variable interpolation.
# (The upstream `.env.example` is for running Postiz from source, not Docker.)
# Never commit the real `.env`.

# === Postiz core
# Public URL of this Postiz instance (no trailing slash)
POSTIZ_URL=http://localhost:4007
# Long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=
DISABLE_REGISTRATION=false

# === X (official X API, unchanged upstream provider)
# https://developer.x.com -> App -> Keys and tokens (OAuth 1.0a API Key / Secret)
# Callback URL: ${POSTIZ_URL}/integrations/social/x
X_API_KEY=
X_API_SECRET=

# === Instagram (official Meta API, unchanged upstream providers)
# "Instagram (Facebook Business)" uses the Facebook app:
# Callback URL: ${POSTIZ_URL}/integrations/social/instagram
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# "Instagram (Standalone)" uses the Instagram app:
# Callback URL: ${POSTIZ_URL}/integrations/social/instagram-standalone
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# === YouTube via Zernio ("YouTube (Zernio)" channel, youtube-zernio provider)
# API key: https://zernio.com/dashboard/api-keys -> Create API key (sk_..., shown once)
ZERNIO_API_KEY=
# Optional: Zernio profile to connect channels into (default: your default profile)
ZERNIO_PROFILE_ID=
# Optional: override the API base URL (default https://zernio.com/api).
ZERNIO_API_URL=
# Automatic retries of a failed Zernio publish (platform/system errors only)
ZERNIO_MAX_RETRIES=2
# Optional: hide the upstream Google-Cloud-based YouTube provider
# HIDDEN_PROVIDERS=youtube
